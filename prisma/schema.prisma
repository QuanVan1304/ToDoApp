generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---
enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum Status {
  TODO
  INPROGRESS
  DONE
}

enum TaskSource {
  MANUAL
  AGENT
  IMPORT
}

enum AgentActionType {
  DELETE_TASK
}

// --- NEXTAUTH MODELS ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String?              @unique
  emailVerified       DateTime?
  image               String?
  accounts            Account[]
  sessions            Session[]
  projects            Project[]
  tasks               Task[]
  tags                Tag[]
  pendingAgentActions PendingAgentAction[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- NOTEBOOK MODELS ---
model Project {
  id        String   @id @default(cuid())
  name      String
  color     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id     String @id @default(cuid())
  name   String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks  Task[]
}

model Task {
  id           String     @id @default(cuid())
  title        String
  notes        String?    @db.Text
  status       Status     @default(TODO)
  priority     Priority   @default(NORMAL)
  scheduledFor DateTime   @default(now()) @db.Date
  dueDate      DateTime?  @db.Date
  completedAt  DateTime?
  order        Float      @default(0)
  source       TaskSource @default(MANUAL)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tags         Tag[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([id, userId])
  @@index([userId, status])
  @@index([userId, projectId])
  @@index([userId, status, scheduledFor])
  @@index([userId, status, completedAt])
}

model PendingAgentAction {
  id        String          @id @default(cuid())
  userId    String
  type      AgentActionType
  payload   Json
  expiresAt DateTime
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([expiresAt])
}
